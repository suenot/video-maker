# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# Input data (audio, PDFs, slides)
input/*
!input/.gitkeep

# Output data (generated videos, metadata, thumbnails, subtitles)
output/*
!output/.gitkeep

# Output from the DaVinci Resolve render path
output_davinci/
*.fcpxml

# Temporary files (slides images, OCR text, subtitles JSON, timelines, logs)
temp/*
!temp/.gitkeep

# Storyboard preview renders (source HTML and assets stay tracked)
storyboards/buzz-claude-code-codex/buzz-blueprint.mp4

# Ingested third-party videos (research input, never committed or republished)
ingest/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# AI assistants (keep skills, exclude the rest)
.claude/*
!.claude/skills/

# Self-authored video pipeline
build/
selfmade/__pycache__/

# Code-drawn collections: renders, preview frames and build copies stay local
collections/**/renders/
collections/**/snapshots/frame-*.png
collections/**/snapshots/contact-sheet-*.jpg
collections/**/snapshots/old/
collections/complex-arbitrage-rust/intro/assets/
collections/complex-arbitrage-rust/style/gallery/assets/
collections/complex-arbitrage-rust/style/gallery/snapshots/
collections/complex-arbitrage-rust/intro/preview/

# collection songs (binary, regenerable via gaia)
collections/**/intro/song_*.mp4
collections/**/intro/song_*.m4a
